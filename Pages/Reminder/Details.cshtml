@page "{id:int}"
@model CarCRM.Pages.Reminders.DetailsModel

<h1>Reminder Details</h1>

<dl class="row">
    <dt class="col-sm-3">Car</dt>
    <dd class="col-sm-9">@Model.Reminder.Car?.DisplayName</dd>

    <dt class="col-sm-3">Reminder Date</dt>
    <dd class="col-sm-9">@Model.Reminder.ReminderDate.ToShortDateString()</dd>

    <dt class="col-sm-3">Service Item</dt>
    <dd class="col-sm-9">@Model.Reminder.ServiceItem</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Reminder.Status</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Reminder.Notes</dd>
</dl>

<p>
    <a asp-page="./Edit" asp-route-id="@Model.Reminder.Id" class="btn btn-warning">Edit</a>
    <a asp-page="./Delete" asp-route-id="@Model.Reminder.Id" class="btn btn-danger">Delete</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</p>