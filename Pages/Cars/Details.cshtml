@page "{id:int}"
@model CarCRM.Pages.Cars.DetailsModel

<h1>Car Details</h1>

<dl class="row">
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@(Model.Car?.Customer?.Name ?? "Not assigned")</dd>

    <dt class="col-sm-2">Plate Number</dt>
    <dd class="col-sm-10">@Model.Car?.PlateNumber</dd>

    <dt class="col-sm-2">Brand</dt>
    <dd class="col-sm-10">@Model.Car?.Brand</dd>

    <dt class="col-sm-2">Model</dt>
    <dd class="col-sm-10">@Model.Car?.Model</dd>

    <dt class="col-sm-2">Year</dt>
    <dd class="col-sm-10">@Model.Car?.Year</dd>
</dl>

<a asp-page="Edit" asp-route-id="@Model.Car?.Id" class="btn btn-warning">Edit</a>
<a asp-page="Index" class="btn btn-secondary">Back to List</a>