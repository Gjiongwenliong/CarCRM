@page
@model CarCRM.Pages.Cars.CreateModel

<h1>Create Car</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Car.PlateNumber"></label>
        <input asp-for="Car.PlateNumber" class="form-control" />
        <span asp-validation-for="Car.PlateNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Car.Brand"></label>
        <input asp-for="Car.Brand" class="form-control" />
        <span asp-validation-for="Car.Brand" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Car.Model"></label>
        <input asp-for="Car.Model" class="form-control" />
        <span asp-validation-for="Car.Model" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Car.Year"></label>
        <input asp-for="Car.Year" class="form-control" />
        <span asp-validation-for="Car.Year" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>
