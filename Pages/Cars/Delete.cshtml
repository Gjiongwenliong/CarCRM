@page "{id:int}"
@model CarCRM.Pages.Cars.DeleteModel

<h1>Delete Car</h1>

@if (Model.Car == null)
{
    <div class="alert alert-warning">Car not found.</div>
}
else
{
    <h3>Are you sure you want to delete this car?</h3>

    <dl class="row">
        <dt class="col-sm-2">Brand</dt>
        <dd class="col-sm-10">@Model.Car.Brand</dd>

        <dt class="col-sm-2">Model</dt>
        <dd class="col-sm-10">@Model.Car.Model</dd>

        <dt class="col-sm-2">Year</dt>
        <dd class="col-sm-10">@Model.Car.Year</dd>
    </dl>

    <form method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
